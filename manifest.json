{
  "manifestVersion": 5,
  "id": "com.local.codex.nanobanan-layer-bridge",
  "name": "我心的赛博工具",
  "version": "1.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "27.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "nanobananPanel",
      "label": {
        "default": "Nanobanan"
      },
      "minimumSize": { "width": 280, "height": 400 },
      "maximumSize": { "width": 900, "height": 4000 },
      "preferredDockedSize": { "width": 340, "height": 800 },
      "preferredFloatingSize": { "width": 400, "height": 900 }
    }
  ],
  "requiredPermissions": {
    "network": { "domains": "all" },
    "localFileSystem": "fullAccess",
    "webview": {
      "allow": "yes",
      "allowLocalRendering": "yes",
      "enableMessageBridge": "localAndRemote",
      "domains": "all"
    }
  }
}
